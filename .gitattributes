# Force LF line endings for shell scripts on all platforms
*.sh text eol=lf

# Force LF for other text files commonly used in CI
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf

compatibility-manifest.yml merge=theirs
