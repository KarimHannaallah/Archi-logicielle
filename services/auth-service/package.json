{
  "name": "auth-service",
  "version": "2.0.1",
  "main": "src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon -L --exec ts-node src/index.ts",
    "test": "cross-env NODE_ENV=test JWT_SECRET=test-secret jest --testPathPattern=spec/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@archi/shared-db": "file:../../packages/shared-db",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.2.3",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.3",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.0",
    "wait-port": "^1.1.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "jest": "^29.3.1",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.3"
  },
  "jest": {
    "rootDir": ".",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results",
          "outputName": "junit.xml"
        }
      ]
    ]
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true
  }
}
