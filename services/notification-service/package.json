{
  "name": "notification-service",
  "version": "1.0.0",
  "main": "src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon -L --exec ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --testPathPattern=spec/"
  },
  "jest": {
      "rootDir": ".",
      "transform": {
          "^.+\\.ts$": "ts-jest",
          "^.+\\.js$": "babel-jest"
      },
      "moduleFileExtensions": ["ts", "js", "json"],
      "reporters": [
          "default",
          ["jest-junit", { "outputDirectory": "test-results", "outputName": "junit.xml" }]
      ]
  },
  "devDependencies": {
      "@types/express": "^4.17.21",
      "@types/jsonwebtoken": "^9.0.7",
      "@types/node": "^25.2.3",
      "@types/supertest": "^6.0.2",
      "@types/uuid": "^10.0.0",
      "babel-jest": "^29.7.0",
      "jest": "^29.3.1",
      "jest-junit": "^17.0.0",
      "nodemon": "^3.1.11",
      "supertest": "^7.2.2",
      "ts-jest": "^29.4.6",
      "typescript": "^5.9.3"
  }
}
