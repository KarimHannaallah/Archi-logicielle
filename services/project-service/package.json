{
  "name": "project-service",
  "version": "1.0.0",
  "main": "src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "test": "jest --testPathPattern=spec/",
    "dev": "nodemon -L --exec ts-node src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.2",
    "ts-node": "^10.9.2",
    "@archi/shared-auth": "file:../../packages/shared-auth",
    "@archi/shared-db": "file:../../packages/shared-db",
    "uuid": "^9.0.0"
  },
  "jest": {
    "rootDir": ".",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "babel-jest"
    },
    "moduleFileExtensions": ["ts", "js", "json"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "reporters": [
      "default",
      ["jest-junit", {
        "outputDirectory": "test-results",
        "outputName": "junit.xml"
      }]
    ]
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.2.3",
    "@types/uuid": "^10.0.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.3.1",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
